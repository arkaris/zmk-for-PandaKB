#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define SETUP 3

/ {
    combos {
        compatible = "zmk,combos";

        del_lshift_bspc {
            timeout-ms = <50>;
            key-positions = <36 23>;
            bindings = <&kp DEL>;
        };

        del_rshift_bspc {
            timeout-ms = <50>;
            key-positions = <49 23>;
            bindings = <&kp DEL>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        setup_layer {
            if-layers = <NAV SYM>;
            then-layer = <SETUP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1   &kp N2   &kp N3   &kp N4    &kp N5                                     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BACKSLASH
&kp ESC &kp Q    &kp W    &kp E    &kp R     &kp T                                      &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BACKSPACE
&kp TAB    &kp A    &kp S    &kp D    &kp F     &kp G                                      &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SINGLE_QUOTE
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp LC(UP)             &kp N  &kp M     &kp COMMA &kp DOT  &kp SLASH &kp RSHFT
                  &kp LCTRL &kp LALT &kp LGUI &mo NAV &kp SPACE              &kp SPACE  &mo SYM &none    &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none     &none     &kp F10   &kp F11   &kp F12   &none                                      &trans     &trans           &trans            &trans     &trans    &trans
&none     &none     &kp F7    &kp F8    &kp F9    &none                                      &kp HOME   &kp LA(LEFT)     &kp LA(RIGHT)     &kp END    &kp PG_UP &kp LG(RBKT)
&none     &none     &kp F4    &kp F5    &kp F6    &none                                      &kp LEFT   &kp DOWN         &kp UP            &kp RIGHT  &kp PG_DN &kp LG(LBKT)
&trans    &none     &kp F1    &kp F2    &kp F3    &none      &trans &trans                  &kp LBKT   &kp RBKT         &kp LG(LA(LEFT))  &kp LG(LA(RIGHT)) &trans    &trans
                  &trans    &trans    &trans    &mo NAV &none                &kp RETURN    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp LBRC  &kp RBRC  &kp PIPE  &trans    &trans    &trans                                      &trans    &kp N7    &kp N8    &kp N9    &trans    &kp MINUS
&kp MINUS &kp EQUAL &kp PLUS  &kp AT_SIGN &kp HASH  &kp DOLLAR                                  &kp LPAR  &kp N4    &kp N5    &kp N6    &kp PLUS  &trans
&trans    &trans    &trans    &trans    &trans    &trans                                      &kp RPAR  &kp N1    &kp N2    &kp N3    &kp ASTERISK &kp EQUAL
&trans    &kp CARET &kp AMPS &trans    &trans    &kp TILDE     &trans &trans                &none     &kp N0    &trans    &trans    &trans    &trans
                  &trans    &trans    &trans    &trans    &kp RETURN               &none    &mo SYM &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        setup_layer {
            display-name = "Setup";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &none &none &none &none &none &none
&none     &none       &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none                              &none &none &none &none &none &none
&none     &none       &kp C_RW   &kp C_PP     &kp C_FF     &none                              &none &none &none &none &none &none
&none     &none       &none     &kp C_BRI_DN &kp C_BRI_UP &none      &trans &trans          &none &none &none &none &none &none
                  &trans    &trans    &trans    &trans    &none                &none    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
        extra3 {
            status = "reserved";
        };
        extra4 {
            status = "reserved";
        };
    };
};
